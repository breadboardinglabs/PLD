Pin 65      = MC51;
Pin 67      = nor; /* MC52; */
Pin 68      = MC53;
Pin 69      = xor; /* MC54; */
Pin 71      = MC55;
/* Pin 73 MC56 TDO JTAG Do Not use */
Pin 75      = MC57;
Pin 76      = xnor; /* MC58; */
Pin 79      = MC59;
Pin 80      = MC60;
Pin 81      = MC61;
Pin 83      = MC62;
Pin 84      = MC63;
Pin 85      = MC64;

/*
 * Logic:  
 * Logic symbols
 * ! NOT  # OR   & AND  $ XOR   .d D Flip-flop Input

 */

