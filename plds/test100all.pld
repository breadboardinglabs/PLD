VCC = Supply Voltage for IO pin which must be connected to (5.0V or 3.3V)
VCCINT = VCC +5V Internal
GND = GND pin which must be connected to ground
TMS,TDI,TDO,TDI = JTAG pins which must reserved for the JTAG interface
NC = Unused I/O pins which must be unconnected on the board
*/

/*
 * JTAG: For programming, don't use. Re-enable JTAG support 12V on OE1 via 1K8 Resistor
 *  
 *  Pin 4  TDI MC8
 *  Pin 15 TMS MC32
 *  Pin 62 TCK MC48
 *  Pin 73 TDO MC56
 *  
 */

/*
 * Inputs:  
 */
Pin 90 = GCLK2_OE2;
Pin 89 = GCLR;
Pin 88 = OE1; /* Also 12V via 1K8 Resistor will restore JTAG programming if disabled */
Pin 87 = GCLK1;
/* Note GLK3 also Pin 85 MC64 */


/*
 * Inputs/Outputs:  
 */

Pin 14      = MC1;
Pin 13      = MC2; 
Pin 12      = MC3;
Pin 10      = MC4; /* MC4; */
Pin 9       = MC5;
Pin 8       = b; /* MC6; */
Pin 6       = a; /* MC7; */
/* Pin 4 MC8 TDI JTAG Do Not use */
Pin 100     = MC9;
Pin 99      = MC10;
Pin 98      = MC11;
Pin 97      = MC12;
Pin 96      = MC13;
Pin 94      = MC14;
Pin 93      = MC15;
Pin 92      = MC16;
Pin 37      = MC17; /* MC17 inva */
Pin 36      = MC18; /* MC18 invb */
Pin 35      = MC19; /* MC19 and */
Pin 33      = MC20; /* MC20 nand */
Pin 32      = MC21; /* MC21 or */
Pin 31      = MC22; /* MC22 nor */
Pin 30      = MC23; /* MC23 xor */
Pin 29      = MC24; /* MC24 xnor */
Pin 25      = MC25;
Pin 23      = MC26;
Pin 21      = MC27;
Pin 20      = MC28;
Pin 19      = MC29;
Pin 17      = MC30;
Pin 16      = MC31;
/* Pin 15 MC32 TMS JTAG Do Not use */
Pin 40      = MC33;
Pin 41      = MC34;
Pin 42      = MC35;
Pin 44      = MC36;
Pin 45      = MC37;
Pin 46      = MC38;
Pin 47      = MC39;
Pin 48      = MC40; /* MC40; */
Pin 52      = MC41;
Pin 54      = MC42;
Pin 56      = MC43;
Pin 57      = MC44;  
Pin 58      = MC45;
Pin 60      = MC46;
Pin 61      = MC47;
/* Pin 62 MC48 TCK JTAG Do Not use */
Pin 63      = MC49;
Pin 64      = MC50;
Pin 65      = MC51; /* MC51; */
Pin 67      = MC52;
Pin 68      = MC53;
Pin 69      = MC54;
Pin 71      = MC55;
/* Pin 73 MC56 TDO JTAG Do Not use */
Pin 75      = MC57;
Pin 76      = MC58;
Pin 79      = MC59;
Pin 80      = MC60;
Pin 81      = MC61;
Pin 83      = MC62;
Pin 84      = MC63;
Pin 85      = MC64;

/*
 * Logic:  
 * Logic symbols
 * ! NOT  # OR   & AND  $ XOR   .d D Flip-flop Input

 */

/* Assign all MC as inputs or outputs to generate pin map */

/* MC1.D = !MC1;
MC1.CK = CLK25;
MC1.CE = 'b'1;
MC1.OE = 'b'1;
MC1.AR = 'b'0;

MC3.D = MC2;
MC3.CKMUX = GCLK2_OE2;
MC3.OEMUX = OE1;
MC3.AR = GCLR;
*/

MC1 = xor;
MC2 = xnor;
MC3 = xor;
MC4 = xnor;
MC5 = xor;
/* MC6 and MC7 ARE b & a */
/* MC8 is TDI */
MC9 = xnor;
MC10 = xor;
MC11 = xnor;
MC12 = xor;
MC13 = xnor;
MC14 = xor;
MC15 = xnor;
MC16 = xor;
MC17 = xnor;
MC18 = xor;
MC19 = xnor;
MC20 = xor;
MC21 = xnor;
MC22 = xor;
MC23 = xnor;
MC24 = xor;
MC25 = xnor;
MC26 = xor;
MC27 = xnor;
MC28 = xor;
MC29 = xnor;
MC30 = xor;
MC31 = xnor;
/* MC32 is TMS */

MC33 = xnor;
MC34 = xor;
MC35 = xnor;
MC36 = xor;
MC37 = xnor;
MC38 = xor;
MC39 = xnor;
MC40 = xor;
MC41 = xnor;
MC42 = xor;
MC43 = xnor;
MC44 = xor;
MC45 = xnor;
MC46 = xor;
MC47 = xnor;
/* MC48 is TCK */

MC49 = xnor;
MC50 = xor;
MC51 = xnor;
MC52 = xor;
MC53 = xnor;
MC54 = xor;
MC55 = xnor;
/* MC56 is TDO */

MC57 = xnor;
MC58 = xor;
MC59 = xnor;
MC60 = xor;
MC61 = xnor;
MC62 = xor;
MC63 = xnor;
MC64 = xor;



inva = !a;              /* inverters */
invb = !b;
and  = a & b;           /* AND gate */
nand = !(a & b);        /* NAND gate */
or   = a # b;           /* OR gate */
nor  = !(a # b);        /* NOR gate */
xor  = a $ b;           /* eXclusive OR gate */
xnor = !(a $ b);        /* eXclusive NOR gate */

