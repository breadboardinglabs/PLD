Pin 42      = MC69;
Pin 44      = MC70;
Pin 45      = MC72;
Pin 46      = MC73;
Pin 47      = MC75;
Pin 48      = MC77;
Pin 49      = MC78;
Pin 50      = MC80;

/* Group F MC81-MC96 */
Pin 52      = MC81;
Pin 53      = MC83;
Pin 54      = MC85;
Pin 55      = MC86;
Pin 56      = MC88;
Pin 57      = MC89;
Pin 58      = MC91;
Pin 60      = MC93;
Pin 61      = MC94;
/* Pin 62 MC96 TCK JTAG Do Not use */

/* Group G MC97-MC112 */
Pin 63      = MC97;
Pin 64      = MC99;
Pin 65      = MC101;
Pin 67      = MC102;
Pin 68      = MC104;
Pin 69      = MC105;
Pin 70      = MC107;
Pin 71      = MC109;
Pin 72      = MC110;
