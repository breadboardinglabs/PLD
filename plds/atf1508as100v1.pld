Pin 79      = MC120;
Pin 80      = MC121;
Pin 81      = MC123;
Pin 83      = MC125;
Pin 84      = MC126;
Pin 85      = MC128;

/*
 * Logic:  
 * Logic symbols
 * ! NOT  # OR   & AND  $ XOR   .d D Flip-flop Input

 */

/* Assign all MC as inputs or outputs to generate pin map */

a = MC25; /* Pin 6 */
b = MC29; /* Pin 8 */

inva = !a;              /* inverters */
invb = !b;
and  = a & b;           /* AND gate */
nand = !(a & b);        /* NAND gate */
or   = a # b;           /* OR gate */
nor  = !(a # b);        /* NOR gate */
xor  = a $ b;           /* eXclusive OR gate */
xnor = !(a $ b);        /* eXclusive NOR gate */

Field MacroCells = [MC128..1];

MC1 = xor;
MC3 = xnor;

/* MC5 = xor;
MC6 = xnor;*/

/* Assign global pins so they appear in pin layout */
Pinnode 602 = MC2;
Pinnode 604 = MC4;

MC2.D = !MC2;
MC2.CK = GCLK1;

MC4.D = !MC4;
MC4.CK = GCLK2_OE2;
MC4.OE = OE1;
MC4.AR = GCLR;

MC5.D = !MC5;
MC5.CK = GCLK1;
MC5.OE = OE1;

MC6.D = (!MC6 & MC5 # MC6 & !MC5);
MC6.CK = GCLK1; 
MC6.OE = OE1;


MC8  = xor;
MC9  = xnor;
MC11 = xor;
MC13 = xnor;
MC14 = xor;
MC16 = xnor;

MC17 = xor;
MC19 = xnor;
MC21 = xor;
MC22 = xnor;
MC24 = xor;
