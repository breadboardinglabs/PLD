                     4 2 1 9 7 6 4   3 1 9   I 5 7 9   0 2 3 5 7 8 0                         
                                             N
                                             T

VCC = Supply Voltage for IO pin which must be connected to (5.0V or 3.3V)
VCCINT = VCC +5V Internal
GND = GND pin which must be connected to ground
TMS,TDI,TDO,TDI = JTAG pins which must reserved for the JTAG interface
NC = Unused I/O pins which must be unconnected on the board
*/

/*
 * JTAG: For programming, don't use. Re-enable JTAG support 12V on OE1 via 1K8 Resistor
 *  
 *  Pin 4  TDI MC8
 *  Pin 15 TMS MC32
 *  Pin 62 TCK MC48
 *  Pin 73 TDO MC56
 *  
 */

/*
 * Inputs:  
 */
Pin 90 = GCLK2_OE2;
Pin 89 = GCLR;
Pin 88 = OE1; /* Also 12V via 1K8 Resistor will restore JTAG programming if disabled */
Pin 87 = GCLK1;
/* Note GLK3 also Pin 85 MC64 */



/*
 * Inputs/Outputs:  
 */

/* Group A MC1-MC16 */
Pin 2       = MC1; 
Pin 1       = MC3; 
Pin 100     = MC5;
Pin 99      = MC6;
Pin 98      = MC8;
Pin 97      = MC9;
Pin 96      = MC11;
Pin 94      = MC13;
Pin 93      = MC14;
Pin 92      = MC16;

/* Group B MC17-MC32 */
Pin 14      = MC17;
Pin 13      = MC19;
Pin 12      = MC21;
Pin 10      = MC22;
Pin 9       = MC24;
Pin 8       = MC25; /* b */
Pin 7       = MC27;
Pin 6       = MC29; /* a */
Pin 5       = MC30;
/* Pin 4 MC32 TDI JTAG Do Not use */

/* Group C MC33-MC48 */
Pin 25      = MC33;
Pin 24      = MC35;
Pin 23      = MC37;
Pin 22      = MC38;
Pin 21      = MC40;
Pin 20      = MC41;
Pin 19      = MC43;
Pin 17      = MC45;
Pin 16      = MC46;
/* Pin 15 MC48 TMS JTAG Do Not use */

/* Group D MC49-MC64 */
